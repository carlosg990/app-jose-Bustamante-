const matches = [
  { id: 1, home: "América", away: "Cruz Azul" },
  { id: 2, home: "Tigres", away: "Monterrey" }
];

let predictions = {};

function renderQuiniela() {
  const container = document.getElementById("quiniela");
  container.innerHTML = "<h2>Quiniela</h2>";

  matches.forEach(match => {
    const div = document.createElement("div");

    div.innerHTML = `
      <p>${match.home} vs ${match.away}</p>
      <button onclick="predict(${match.id}, 'home')">Local</button>
      <button onclick="predict(${match.id}, 'draw')">Empate</button>
      <button onclick="predict(${match.id}, 'away')">Visitante</button>
    `;

    container.appendChild(div);
  });
}

function predict(matchId, result) {
  predictions[matchId] = result;
  console.log(predictions);
}

renderQuiniela();
