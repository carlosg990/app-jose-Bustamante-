body {
  font-family: Arial, sans-serif;
  background-color: #f4f6f8;
  color: #333;
  display: flex;
  justify-content: center;
  padding: 20px;
}

.app {
  width: 100%;
  max-width: 500px;
  background: white;
  padding: 20px;
  border-radius: 10px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

h1 {
  text-align: center;
  color: #0b5ed7;
}

nav {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20px;
}

.nav-btn {
  padding: 10px 15px;
  border: none;
  background-color: #e0e0e0;
  cursor: pointer;
  border-radius: 5px;
  font-weight: bold;
}

.nav-btn.active {
  background-color: #0b5ed7;
  color: white;
}

.card {
  border: 1px solid #ddd;
  padding: 15px;
  border-radius: 8px;
  margin-bottom: 12px;
  background-color: #fafafa;
}

button {
  margin: 5px;
  padding: 8px 12px;
  border: none;
  border-radius: 4px;
  background: #28a745;
  color: white;
  cursor: pointer;
}

button.selected {
  background: #ffc107;
  color: #000;
  font-weight: bold;
}

button:hover {
  opacity: 0.9;
}

.my-team-list {
  margin-top: 15px;
  background-color: #eef2f5;
  padding: 10px;
  border-radius: 5px;
}
